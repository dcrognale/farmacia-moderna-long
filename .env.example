# Storefront API de Tiendanube (pública: no pongas tokens acá, el navegador no puede enviarlos)
# ID numérico de la tienda con la Storefront API habilitada
VITE_TIENDANUBE_STORE_ID=
# Versión de la API (por defecto 2026-11)
VITE_TIENDANUBE_API_VERSION=2026-11
# Opcional: hosts permitidos para redirigir al checkout, separados por coma (ej: checkout.mitienda.com,mitienda.mitiendanube.com)
# Si queda vacío, solo se exige https.
VITE_CHECKOUT_ALLOWED_HOSTS=
